classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_pets() list~Pet~
        +set_availability(minutes: int) None
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +str priority
        +str frequency
        +time preferred_time
        +date last_completed
        +priority_rank() int
        +mark_complete(on: date) None
        +is_completed(on: date) bool
        +is_due_today(today: date) bool
        +edit(**changes) None
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +datetime start
        +datetime end
        +str reason
    }

    class Scheduler {
        +Owner owner
        +date day
        +list~ScheduledTask~ plan
        +list skipped
        +generate_plan() list~ScheduledTask~
        +sort_by_priority(tasks: list) list
        +filter_by_time(tasks: list) list
        +detect_conflicts() list
        +explain_plan() str
        -_add_entry(pet, task, start, reason) None
        -_next_free_slot(earliest: datetime, duration_minutes: int) datetime
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : plans for
    Scheduler "1" *-- "*" ScheduledTask : builds
    ScheduledTask --> Pet
    ScheduledTask --> Task
